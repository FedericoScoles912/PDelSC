# URL base de la API REST para Expo Web (localhost)
# NOTA PARA DISPOSITIVOS MÓVILES FÍSICOS O EMULADORES:
# Si pruebas la app en tu teléfono con Expo Go, reemplaza 'localhost'
# por la dirección IP local de tu computadora en la red Wi-Fi (ejemplo: http://192.168.1.45:3000/api)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
