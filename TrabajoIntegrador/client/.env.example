# ============================================================
#  FRONTEND (Expo) - variables EXPO_PUBLIC_*
#  Se copian a client/.env (este archivo es la plantilla).
#
#  - Web / emulador Android: usá localhost (el emulador usa 10.0.2.2
#    por defecto, ya contemplado en Services/apiConfig.js).
#  - Teléfono físico (Expo Go): apuntá a la IP LAN de tu PC.
# ============================================================
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1
