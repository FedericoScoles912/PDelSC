# ============================================================
#  BACKEND (Node.js + Express)
# ============================================================
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=retenes_stock
DB_CONNECTION_LIMIT=10

# --- JWT ---
JWT_ACCESS_SECRET=cambia_esta_clave_de_access_token_larga_y_segura
JWT_REFRESH_SECRET=cambia_esta_clave_de_refresh_token_distinta_y_segura
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:8081

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ============================================================
#  OAUTH SOCIAL (Google / Facebook / GitHub)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL base del backend usada para armar los redirect URIs de OAuth
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# ============================================================
#  IMPORTACIÓN
# ============================================================
EXCEL_PATH=./imports/Retenes_EMIC__Lista_de_Precios_-_Vigencia_01_Nov_2025.xlsx
IMPORT_LOG_DIR=./imports/logs

# ============================================================
#  FRONTEND (Expo) - copiar a client/.env
#  EXPO_PUBLIC_API_URL=http://192.168.0.10:4000/api/v1
# ============================================================
