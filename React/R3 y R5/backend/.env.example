# ========== APP ==========
NODE_ENV=development
PORT=5000

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173

# ========== MYSQL ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=auth_system

# ========== JWT ==========
ACCESS_TOKEN_SECRET=replace_me_with_a_long_random_string_access
REFRESH_TOKEN_SECRET=replace_me_with_a_long_random_string_refresh
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ========== OAUTH - GOOGLE ==========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/oauth/google/callback

# ========== OAUTH - META / FACEBOOK ==========
META_CLIENT_ID=
META_CLIENT_SECRET=
META_CALLBACK_URL=http://localhost:5000/api/oauth/meta/callback

# ========== OAUTH - GITHUB ==========
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/oauth/github/callback

# ========== OAUTH - X / TWITTER ==========
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:5000/api/oauth/twitter/callback

# ========== OAUTH - DISCORD ==========
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:5000/api/oauth/discord/callback

# ========== OAUTH - TWITCH ==========
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL=http://localhost:5000/api/oauth/twitch/callback
