# =========================================
# Variables de entorno — Portfolio Personal
# Copiá este archivo a .env y completá los valores
# NO subas el archivo .env al repositorio
# =========================================

# --- Servidor Express ---
PORT=3001

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# --- Frontend (Vite) ---
# En desarrollo, Vite usa esta URL para consumir la API
# En producción con despliegue monolítico (Render) se puede usar "" (raíz relativa)
VITE_API_BASE_URL=http://localhost:3001
