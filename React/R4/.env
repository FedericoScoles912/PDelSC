# =========================================
# Variables de entorno — Portfolio Personal
# Copiá este archivo a .env y completá los valores
# NO subas el archivo .env al repositorio
# =========================================

# --- Servidor Express (solo desarrollo local) ---
# En Vercel NO definas PORT: lo inyecta la plataforma.
PORT=3001

# --- Base de datos TiDB Cloud ---
# Copiá estos datos desde TiDB Cloud → tu clúster → Connect.
# El puerto de TiDB Cloud es 4000 (no 3306).
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=portfolio_db
DB_USER=35JGPMj77Y5ffj5.root
DB_PASSWORD=B0szNFGbEB0joNjT

# TiDB Cloud exige TLS en el endpoint público. Dejalo en true.
DB_SSL=true

# Alternativa: cadena de conexión completa (tiene prioridad sobre las DB_*).
# DATABASE_URL=mysql://35JGPMj77Y5ffj5.root:35JGPMj77Y5ffj5@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/portfolio_db

# --- Panel /admin ---
# Usá valores únicos y robustos en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=un_secreto_aleatorio_largo

# --- Frontend (Vite) ---
# Desarrollo local: Vite redirige /api al servidor Express.
VITE_API_BASE_URL=http://localhost:3001
# En Vercel dejala VACÍA (o no la definas): el frontend llama a /api en el
# mismo dominio, sin CORS ni URLs absolutas.
