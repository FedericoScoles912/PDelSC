# =========================================
# Variables de entorno — Portfolio Personal
# Copiá este archivo a .env y completá los valores
# NO subas el archivo .env al repositorio
# =========================================

# --- Servidor Express ---
PORT=3001

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=fede2004.

# Alternativa para hosting: cadena de conexión MySQL completa.
# Si existe, tiene prioridad sobre las variables DB_*.
# DATABASE_URL=mysql://usuario:contraseña@host:3306/portfolio_db

# Acceso al panel /admin. Usá valores únicos y robustos en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123.
ADMIN_SESSION_SECRET=federico2407.

# --- Frontend (Vite) ---
# En desarrollo, Vite usa esta URL para consumir la API
# En producción con despliegue monolítico (Render) se puede usar "" (raíz relativa)
VITE_API_BASE_URL=http://localhost:3001
