# =====================================================================
# SERVIDOR
# =====================================================================
PORT=4000
NODE_ENV=development
# Origen exacto del frontend (Vite suele usar 5173). El CORS queda restringido a este valor.
FRONTEND_URL=http://localhost:5173
# URL publica del backend (se usa para construir los callback URL de OAuth).
BACKEND_URL=http://localhost:4000

# =====================================================================
# BASE DE DATOS (MySQL)
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=user_auth_system

# =====================================================================
# JWT
# =====================================================================
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# =====================================================================
# FRONTEND (Vite) - solo las variables con prefijo VITE_ llegan al navegador
# =====================================================================
# URL base de la API REST que consumen ambos sistemas (A y B).
VITE_API_URL=http://localhost:4000/api

# =====================================================================
# OAUTH 2.0 - un bloque por proveedor
# Callback URL a registrar en cada proveedor:
#   <BACKEND_URL>/api/auth/<provider>/callback
# Scopes minimos: email + perfil basico.
# Un proveedor sin CLIENT_ID/SECRET queda deshabilitado (no se registra
# su estrategia) y su boton no debe ofrecerse en el frontend.
# =====================================================================

# Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Meta for Developers (Facebook)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# GitHub Developer Settings
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# X Developer Portal (OAuth 2.0 + PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:4000/api/auth/x/callback

# Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback

# Twitch Developer Console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CALLBACK_URL=http://localhost:4000/api/auth/twitch/callback

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# LinkedIn Developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:4000/api/auth/linkedin/callback
