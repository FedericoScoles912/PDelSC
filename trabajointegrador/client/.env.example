# ============================================================
#  FRONTEND (Expo)  —  desarrollo local
#  Copiar a `.env` y ajustar según el entorno.
#  Sólo las variables con prefijo EXPO_PUBLIC_ llegan al bundle.
# ============================================================

# URL base de la API (debe incluir el prefijo /api/v1).
# - Emulador Android : http://10.0.2.2:4000/api/v1
# - Expo Web / iOS   : http://localhost:4000/api/v1
# - Dispositivo físico (Expo Go): http://<IP-LAN-de-la-PC>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Timeout de peticiones en milisegundos.
EXPO_PUBLIC_API_TIMEOUT=20000
