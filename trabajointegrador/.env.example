# ============================================================
#  BACKEND (Node.js + Express)
#  Copiar a `.env` y completar los valores reales.
#  NUNCA subir el `.env` al repositorio.
# ============================================================

# --- Entorno ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Base de datos MySQL compatible con TiDB Cloud ---
# TiDB Cloud exige TLS. DB_USER tiene el formato "<prefijo>.root".
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxxxxxxxxx.root
DB_PASSWORD=xxxxxxxxxxxxxxxx
DB_NAME=retenes_stock
DB_SSL=true
# CA opcional (ruta al certificado). Si se omite y rejectUnauthorized=true,
# Node valida contra el almacén de CAs del sistema / ISRG Root X1.
# DB_SSL_CA=./certs/isrgrootx1.pem
DB_POOL_LIMIT=5

# --- JWT ---
JWT_ACCESS_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- CORS (lista separada por comas) ---
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- OAuth social (Google / Facebook / GitHub) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# --- Importación del Excel ---
EXCEL_PATH=./imports/Retenes_EMIC__Lista_de_Precios_-_Vigencia_01_Nov_2025.xlsx
IMPORT_LOG_DIR=./imports/logs
