{
  "name": "retenes-stock-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend (API REST) del Sistema de Control de Stock para distribuidor de retenes y sellos automotrices (EMIC). Node.js + Express + MySQL/TiDB.",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "import:excel": "node Scripts/importar_excel.js",
    "import:sql": "node Scripts/importar_excel.js --solo-sql",
    "db:migrate": "node Scripts/ejecutar_sql.js",
    "db:rollback": "node Scripts/ejecutar_sql.js --rollback",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch"
  },
  "keywords": [
    "stock",
    "retenes",
    "express",
    "tidb",
    "mysql",
    "api-rest"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
