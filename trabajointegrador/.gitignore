# ============================================================
#  .gitignore  --  Sistema de Control de Stock (Retenes EMIC)
# ============================================================

# --- Dependencias ---
node_modules/
.pnp/
.pnp.js

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example
*.pem
certs/

# --- Expo / React Native ---
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
ios/
android/

# --- Builds / artefactos ---
build/
*.apk
*.aab
*.ipa
*.hprof

# --- Logs y temporales del importador ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
imports/logs/
imports/uploads/

# --- Testing / cobertura ---
coverage/
.jest-cache/

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
